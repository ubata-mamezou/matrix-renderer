{
  "name": "matrix-renderer",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "matrix-renderer": "./src/cli.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "src",
    "examples"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:dev": "npm run lint && npm run test && npm run render:examples",
    "lint": "biome lint src test --fix",
    "render": "node src/cli.js render",
    "render:examples": "bash render-examples.sh",
    "test": "node --test && bash test-behavior.sh"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
