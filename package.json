{
  "name": "matrix-renderer",
  "version": "0.2.0",
  "description": "Render 2D matrix diagrams (SVG/PNG) from YAML definitions.",
  "main": "src/cli.js",
  "type": "module",
  "bin": {
    "matrix-renderer": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:dev": "npm run lint && npm audit fix && npm run test && npm run render:examples",
    "lint": "biome lint src test",
    "render": "node src/cli.js render",
    "render:examples": "bash render-examples.sh",
    "test": "node --test && bash test-behavior.sh",
    "test:coverage": "node --test --experimental-test-coverage && bash test-behavior.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubata-mamezou/matrix-renderer.git"
  },
  "keywords": [
    "matrix",
    "matrix-renderer",
    "2d-array",
    "canvas",
    "visualization",
    "renderer"
  ],
  "author": "ubata-mamezou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ubata-mamezou/matrix-renderer/issues"
  },
  "homepage": "https://github.com/ubata-mamezou/matrix-renderer#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}