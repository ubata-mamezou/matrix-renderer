{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "assist": {
        "enabled": false
    },
    "css": {
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 2
        },
        "linter": {
            "enabled": true
        },
        "parser": {
            "cssModules": true
        }
    },
    "files": {
        "includes": [
            "**/*.js"
        ],
        "ignoreUnknown": false,
        "ignore": []
    },
    "formatter": {
        "enabled": false,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 120,
        "ignore": []
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "warn",
                "noUnusedImports": "warn",
                "noUndeclaredVariables": "error"
            }
        }
    },
    "organizeImports": {
        "enabled": true
    },
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}